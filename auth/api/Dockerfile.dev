# syntax=docker/dockerfile:1.7
FROM oven/bun:1 AS base
WORKDIR /app

COPY package.json bun.lock ./
COPY auth/api/package.json ./auth/api/
COPY auth/web/package.json ./auth/web/
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/package.json ./apps/api/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/web/package.json ./apps/web/
COPY apps/workflows/package.json ./apps/workflows/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY packages/logger/package.json ./packages/logger/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,id=bun-install-cache,target=/root/.bun/install/cache \
    bun install --filter @bookshare/auth-api --frozen-lockfile

COPY packages/logger ./packages/logger
COPY auth/api ./auth/api
COPY tsconfig.base.json ./

WORKDIR /app/auth/api

EXPOSE 3340

CMD ["bun", "run", "dev"]
