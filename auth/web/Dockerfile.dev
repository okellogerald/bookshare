FROM oven/bun:1 AS base
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY auth/web/package.json ./auth/web/
COPY auth/api/package.json ./auth/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/package.json ./apps/api/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/web/package.json ./apps/web/
COPY apps/workflows/package.json ./apps/workflows/

RUN bun install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY auth/web ./auth/web
COPY tsconfig.base.json ./

WORKDIR /app/auth/web

EXPOSE 3337

CMD ["bun", "run", "dev"]
