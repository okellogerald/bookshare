# ═══════════════════════════════════════════════════════════════
# Makefile.dev — Development Environment
# Usage: make -f Makefile.dev <target>
# ═══════════════════════════════════════════════════════════════

COMPOSE_FILE ?= docker-compose.dev.yml
COMPOSE := docker compose -f $(COMPOSE_FILE)
DB_URL  := postgresql://bookshare:bookshare_dev@localhost:5434/bookshare
DELETE_MEMBER_EMAIL ?= codex.auth.check@example.com

.DEFAULT_GOAL := help

# ─── Docker Compose ───────────────────────────────────────────

.PHONY: up
up: ## Start all services (detached)
	$(COMPOSE) up -d --remove-orphans

.PHONY: up-build
up-build: ## Start all services with image rebuild
	$(COMPOSE) up -d --build --remove-orphans

.PHONY: down
down: ## Stop all services
	$(COMPOSE) down --remove-orphans

.PHONY: restart
restart: ## Restart all services
	$(COMPOSE) restart

.PHONY: ps
ps: ## List running services
	$(COMPOSE) ps

.PHONY: logs
logs: ## Tail logs for all services
	$(COMPOSE) logs -f

.PHONY: logs-%
logs-%: ## Tail logs for a specific service (e.g. make -f Makefile.dev logs-api)
	$(COMPOSE) logs -f $*

.PHONY: shell-%
shell-%: ## Open a shell in a running service container (e.g. make -f Makefile.dev shell-api)
	$(COMPOSE) exec $* sh

# ─── Database ─────────────────────────────────────────────────

.PHONY: db-generate
db-generate: ## Generate Drizzle migrations from schema
	DATABASE_URL=$(DB_URL) bun run --cwd packages/db generate

.PHONY: db-migrate
db-migrate: ## Run pending database migrations (schema + PostgREST read API)
	DATABASE_URL=$(DB_URL) bun run --cwd packages/db migrate

.PHONY: db-push
db-push: ## Push schema directly to database (no migration files)
	DATABASE_URL=$(DB_URL) bun run --cwd packages/db push

.PHONY: db-studio
db-studio: ## Open Drizzle Studio GUI
	DATABASE_URL=$(DB_URL) bun run --cwd packages/db studio

.PHONY: db-post-migrate
db-post-migrate: ## Reapply PostgREST RLS, views, grants, and cache reload
	psql -v ON_ERROR_STOP=1 "$(DB_URL)" -f packages/db/src/migrations/0002_postgrest_read_api.sql

.PHONY: db-reset-user-data
db-reset-user-data: ## Reset app state, keep catalog tables + member profiles
	DB_URL=$(DB_URL) DELETE_MEMBER_EMAIL=$(DELETE_MEMBER_EMAIL) \
		./scripts/dev-reset-state.sh

.PHONY: db-seed
db-seed: ## Seed categories from CATEGORIES_FILE (generic CSV/TSV, Thema CSV/XLSX, or licensed BISAC CSV/XLSX)
	DATABASE_URL=$(DB_URL) CATEGORIES_FILE="$(CATEGORIES_FILE)" CATEGORIES_FORMAT="$(CATEGORIES_FORMAT)" bun run --cwd packages/db seed

.PHONY: db-psql
db-psql: ## Open an interactive psql shell
	psql "$(DB_URL)"

.PHONY: db-reset
db-reset: ## Reset database volume and reapply all database migrations
	$(COMPOSE) down -v
	$(COMPOSE) up -d postgres
	@until psql "$(DB_URL)" -c 'select 1' >/dev/null 2>&1; do sleep 1; done
	$(MAKE) db-migrate
	$(COMPOSE) up -d --remove-orphans

.PHONY: reset
reset: db-reset-user-data ## Reset local app state, keep catalog + member profiles

# ─── Cleanup ──────────────────────────────────────────────────

.PHONY: clean
clean: ## Remove all containers, volumes, and orphans
	$(COMPOSE) down -v --remove-orphans

# ─── Help ─────────────────────────────────────────────────────

.PHONY: help
help: ## Show this help
	@grep -h -E '^[a-zA-Z_%-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

docker-ps:
	@docker ps --format "{{.ID}}|{{.Image}}|{{.RunningFor}}|{{.Status}}|{{.Ports}}" | \
	awk -F'|' 'BEGIN {print "CONTAINER ID|IMAGE|CREATED|STATUS|PORT"} \
	{split($$5,a,","); split(a[1],b,"->"); split(b[1],c,":"); print $$1 "|" $$2 "|" $$3 "|" $$4 "|" c[length(c)]}' | \
	column -t -s '|'