# syntax=docker/dockerfile:1.7
FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY packages/logger/package.json ./packages/logger/
COPY auth/web/package.json ./auth/web/
COPY auth/api/package.json ./auth/api/
COPY apps/api/package.json ./apps/api/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/web/package.json ./apps/web/
COPY apps/workflows/package.json ./apps/workflows/
COPY apps/admin/package.json ./apps/admin/

RUN --mount=type=cache,id=bun-install-cache,target=/root/.bun/install/cache \
    bun install --filter @bookshare/admin --frozen-lockfile

COPY packages/logger ./packages/logger
COPY apps/admin ./apps/admin
COPY tsconfig.base.json ./

WORKDIR /app/apps/admin
RUN bun run build

FROM oven/bun:1-slim AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./.next/static

USER nextjs

EXPOSE 3338

ENV PORT=3338
ENV HOSTNAME="0.0.0.0"

CMD ["bun", "run", "server.js"]
