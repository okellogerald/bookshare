# ─── Build Stage ───────────────────────────────────────────────
FROM oven/bun:1 AS builder
WORKDIR /app

ARG III_VERSION=v0.8.0
ARG TARGETARCH

RUN set -eux; \
    case "${TARGETARCH}" in \
      "arm64") III_TARGET="aarch64-unknown-linux-gnu" ;; \
      "amd64") III_TARGET="x86_64-unknown-linux-gnu" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    curl -fsSL "https://github.com/iii-hq/iii/releases/download/${III_VERSION}/iii-${III_TARGET}.tar.gz" -o /tmp/iii.tar.gz; \
    tar -xzf /tmp/iii.tar.gz -C /usr/local/bin iii; \
    chmod +x /usr/local/bin/iii; \
    rm -f /tmp/iii.tar.gz

COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY auth/web/package.json ./auth/web/
COPY auth/api/package.json ./auth/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/workflows/package.json ./apps/workflows/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN bun install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/workflows ./apps/workflows
COPY tsconfig.base.json ./

RUN bun run --cwd apps/workflows build

# ─── Production Stage ─────────────────────────────────────────
FROM oven/bun:1-slim AS runner
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid 1001 motia

COPY --from=builder --chown=motia:nodejs /app ./
COPY --from=builder /usr/local/bin/iii /usr/local/bin/iii

USER motia

WORKDIR /app/apps/workflows

EXPOSE 3335

CMD ["bun", "run", "start"]
