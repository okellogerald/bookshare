# syntax=docker/dockerfile:1.7

# ─── Build Stage ───────────────────────────────────────────────
FROM oven/bun:1 AS builder
WORKDIR /app

COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY packages/logger/package.json ./packages/logger/
COPY auth/web/package.json ./auth/web/
COPY auth/api/package.json ./auth/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/package.json ./apps/api/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/web/package.json ./apps/web/
COPY apps/workflows/package.json ./apps/workflows/

RUN --mount=type=cache,id=bun-install-cache,target=/root/.bun/install/cache \
    bun install --filter @bookshare/api --frozen-lockfile

COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY packages/importer ./packages/importer
COPY packages/logger ./packages/logger
COPY apps/api ./apps/api
COPY tsconfig.base.json ./

WORKDIR /app/apps/api
RUN bun run build

# ─── Production Stage ─────────────────────────────────────────
FROM oven/bun:1-slim AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/packages/logger ./packages/logger
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/package.json ./

USER nestjs

EXPOSE 3333

CMD ["bun", "run", "dist/main.js"]
