# syntax=docker/dockerfile:1.7
FROM oven/bun:1 AS base
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace root files
COPY package.json bun.lock ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/importer/package.json ./packages/importer/
COPY packages/logger/package.json ./packages/logger/
COPY auth/web/package.json ./auth/web/
COPY auth/api/package.json ./auth/api/
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/package.json ./apps/api/
COPY apps/bookstores/package.json ./apps/bookstores/
COPY apps/web/package.json ./apps/web/
COPY apps/workflows/package.json ./apps/workflows/

# Install dependencies
RUN --mount=type=cache,id=bun-install-cache,target=/root/.bun/install/cache \
    bun install --filter @bookshare/api --frozen-lockfile

# Copy source (volumes will override in dev)
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY packages/importer ./packages/importer
COPY packages/logger ./packages/logger
COPY apps/api ./apps/api
COPY tsconfig.base.json ./

WORKDIR /app/apps/api

EXPOSE 3333

CMD ["bun", "run", "dev"]
