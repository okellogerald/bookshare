# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=bookshare
POSTGRES_PASSWORD=bookshare_dev
DATABASE_URL=postgresql://bookshare:bookshare_dev@localhost:5434/bookshare

# ─── PostgREST ────────────────────────────────────────────────
POSTGREST_DB_PASSWORD=postgrest_dev

# ─── Auth Provider (default: Ory stack) ──────────────────────
AUTH_PROVIDER=ory
PUBLIC_OIDC_URL=http://localhost:4444
OIDC_ISSUER_URL=http://localhost:4444
OIDC_ISSUER_INTERNAL=http://hydra:4444
OIDC_INTERNAL_URL=http://hydra:4444
OIDC_CLIENT_ID=bookshare-web
OIDC_JWKS_URI=http://hydra:4444/.well-known/jwks.json
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:4444/oauth2/auth
OIDC_TOKEN_ENDPOINT=http://hydra:4444/oauth2/token
OIDC_USERINFO_ENDPOINT=http://hydra:4444/userinfo
OIDC_END_SESSION_ENDPOINT=http://localhost:4444/oauth2/sessions/logout
OIDC_ADDITIONAL_SCOPES=offline_access
# Optional in dev: PostgREST auto-fetches JWKS when this is empty.
OIDC_JWT_SECRET=
AUTH_PORTAL_URL=http://localhost:3337
NEXT_PUBLIC_AUTH_PORTAL_URL=http://localhost:3337

# ─── Ory (dev secrets/images) ────────────────────────────────
ORY_HYDRA_IMAGE=oryd/hydra:v25.4.0
ORY_KRATOS_IMAGE=oryd/kratos:v25.4.0
AUTH_PORTAL_PUBLIC_URL=http://localhost:3337
KRATOS_BROWSER_URL=http://localhost:4433
KRATOS_PUBLIC_INTERNAL_URL=http://kratos:4433
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_REMEMBER_FOR=3600

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=bookshare
MINIO_SECRET_KEY=bookshare_dev
MINIO_BUCKET=bookshare-media-dev
MINIO_ROOT_USER=bookshare
MINIO_ROOT_PASSWORD=bookshare_dev
MINIO_BUCKET_DEV=bookshare-media-dev
MINIO_BUCKET_PROD=bookshare-media-prod

# ─── App URLs ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3334
PUBLIC_API_URL=http://localhost:3333/api
API_INTERNAL_URL=http://api:3333/api
PUBLIC_POSTGREST_URL=http://localhost:3336
POSTGREST_INTERNAL_URL=http://postgrest:3000
PUBLIC_MINIO_URL=http://localhost:9002
NEXT_PUBLIC_APP_URL=http://localhost:3334
HIDDEN_USERNAMES=admin,admin_bookshare_local
HIDDEN_USER_IDS=

# ─── Email (Submissions) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUBMISSIONS_EMAIL_TO=

# ─── Nginx (production) ──────────────────────────────────────
HTTP_PORT=80
